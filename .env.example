# ─────────────────────────────────────────────────────────────
# SMTP Email Configuration
# Copy this file to .env.local for local testing with vercel dev
# NEVER commit .env.local to git — it's already in .gitignore
# ─────────────────────────────────────────────────────────────

SMTP_HOST=Crossinvestgh.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@crossinvestgh.com
SMTP_PASS=your_smtp_password_here

# The inbox that receives contact form submissions
CONTACT_TO=info@crossinvestgh.com
